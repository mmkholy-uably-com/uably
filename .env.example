# Copy to .env.local (or set in your host's build env) and fill in.
# All values are inlined at build time (static export), so rebuild after changing.

# Google Analytics 4 measurement ID. Leave empty to disable GA entirely.
# Find it in GA4: Admin > Data Streams > your web stream > "Measurement ID".
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (the content="..." value from
# the "HTML tag" verification method). Leave empty to omit the meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=

# Booking link used by every "book a call" CTA (Calendly / Cal.com / etc.).
# Defaults to the current Calendly link if unset.
NEXT_PUBLIC_BOOKING_URL=

# Google Tag Manager container ID. Defaults to GTM-TM9L9F9J if unset.
NEXT_PUBLIC_GTM_ID=

# Contact-form endpoint (a hosted form backend). Examples:
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   Web3Forms:  https://api.web3forms.com/submit  (also set NEXT_PUBLIC_FORM_ACCESS_KEY)
# Leave empty and the form falls back to opening the visitor's email client (mailto).
NEXT_PUBLIC_FORM_ENDPOINT=

# Public access key required by some form providers (e.g. Web3Forms). Safe to expose.
NEXT_PUBLIC_FORM_ACCESS_KEY=
